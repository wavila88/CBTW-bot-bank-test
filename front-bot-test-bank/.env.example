# Copy this file to .env.local and fill in the values. Never commit real values.

# Address of the Bank Test API, without a trailing slash (for example http://localhost:5082).
VITE_API_BASE_URL=

# Only for `npm run test:e2e`: the address where the end-to-end tests start the front (for example https://localhost:5174).
# The API's Cors__AllowedOrigin must be this same address, and VITE_API_BASE_URL must point to a running API.
E2E_BASE_URL=

# Only for `npm run test:e2e`: where the end-to-end tests start a second API instance whose guide search points
# to a wrong host, so it answers a real error (for example https://localhost:7390). Any free port works.
E2E_BROKEN_API_URL=
